{
  "name": "@nodebuilderjs/core",
  "version": "0.4.2",
  "description": "Native Linux UI in TypeScript: TSX components with SolidJS-style reactivity, drawn by its own native core (Wayland/X11 + GLES2 + FreeType/HarfBuzz). No DOM, no Electron, no GTK/Qt.",
  "keywords": [
    "gui",
    "desktop",
    "linux",
    "wayland",
    "x11",
    "native",
    "jsx",
    "tsx",
    "signals",
    "bun"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipebrgs1/nodebuilderjs.git"
  },
  "homepage": "https://github.com/felipebrgs1/nodebuilderjs#readme",
  "bugs": "https://github.com/felipebrgs1/nodebuilderjs/issues",
  "bin": {
    "nodebuilder": "./cli/nodebuilder.ts"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "bun": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./jsx-runtime": {
      "types": "./lib/jsx-runtime.d.ts",
      "bun": "./src/jsx-runtime.ts",
      "default": "./lib/jsx-runtime.js"
    },
    "./jsx-dev-runtime": {
      "types": "./lib/jsx-runtime.d.ts",
      "bun": "./src/jsx-runtime.ts",
      "default": "./lib/jsx-runtime.js"
    },
    "./testing": {
      "types": "./lib/testing.d.ts",
      "bun": "./src/testing.ts",
      "default": "./lib/testing.js"
    },
    "./charts": {
      "types": "./lib/charts/index.d.ts",
      "bun": "./src/charts/index.ts",
      "default": "./lib/charts/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cli",
    "packages/create-nodebuilderjs/template/AGENTS.md",
    "packages/create-nodebuilderjs/template/.agents",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:native": "sh scripts/build-native.sh",
    "typecheck": "tsc --noEmit -p .",
    "check:snippets": "bun scripts/check-snippets.ts",
    "test": "bun test",
    "counter": "bun examples/apps/counter.tsx",
    "todo": "bun examples/apps/todo.tsx",
    "images": "bun examples/showcase/images.tsx",
    "icons": "bun examples/showcase/icons.tsx",
    "drawing": "bun examples/showcase/drawing.tsx",
    "charts": "bun examples/showcase/charts.tsx",
    "overlays": "bun examples/showcase/overlays.tsx",
    "text": "bun examples/showcase/text.tsx",
    "widgets": "bun examples/showcase/widgets.tsx",
    "tray": "bun examples/showcase/tray.tsx",
    "scroll": "bun examples/showcase/scroll.tsx",
    "dev": "bun --watch examples/apps/todo.tsx",
    "bench": "NB_STATS=1 bun examples/bench/bench.tsx",
    "bench:dashboard": "NB_STATS=1 bun examples/bench/dashboard.tsx",
    "measure": "sh scripts/measure.sh",
    "package": "bun cli/nodebuilder.ts package",
    "npm:build": "bun scripts/npm.ts",
    "npm:publish": "bun scripts/npm.ts --publish"
  },
  "engines": {
    "bun": ">=1.4"
  },
  "optionalDependencies": {
    "@nodebuilderjs/linux-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "node-api-headers": "^1.9.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
