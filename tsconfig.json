{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@nodebuilderjs/core",
    "paths": { "@nodebuilderjs/core": ["./src/index.ts"], "@nodebuilderjs/core/*": ["./src/*.ts"] },
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src", "examples", "test", "scripts", "cli"]
}
